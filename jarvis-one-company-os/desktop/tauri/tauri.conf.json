{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis One Company OS",
  "version": "0.1.0",
  "identifier": "com.jarvis.onecompanyos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Jarvis One Company OS",
        "width": 1440,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
