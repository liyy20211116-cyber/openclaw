{
  "name": "jarvis-one-company-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run dev:full",
    "dev:ui": "vite",
    "dev:full": "npx tsx scripts/dev-stack.ts",
    "desktop:guide": "npx tsx scripts/desktop-entry.ts",
    "desktop:dev": "npx tsx scripts/desktop-dev.ts",
    "desktop:build": "npm run build && npx tsc -p tsconfig.electron.json",
    "desktop:prod": "npx tsx scripts/desktop-prod.ts",
    "desktop:package": "npx tsx scripts/desktop-package.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:export": "npx tsx scripts/export-app-data.ts",
    "db:create-task": "npx tsx scripts/create-task.ts",
    "db:decide-approval": "npx tsx scripts/decide-approval.ts",
    "db:writeback-api": "npx tsx scripts/writeback-api.ts",
    "desktop:start": "npm run desktop:dev",
    "db:studio": "prisma studio"
  },
  "build": {
    "appId": "com.jarvis.onecompanyos",
    "productName": "Jarvis One Company OS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "desktop/electron/package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jarvis One Company OS"
    }
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "better-sqlite3": "^12.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prisma": "^7.7.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "wait-on": "^9.0.4"
  }
}
