{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JarvisFeatures",
  "type": "object",
  "required": ["plan"],
  "properties": {
    "plan": { "enum": ["starter", "pro", "enterprise", "internal"] },
    "agents":    { "type": "object", "additionalProperties": { "type": "boolean" } },
    "packs":     { "type": "object", "additionalProperties": { "type": "boolean" } },
    "skills":    { "type": "object", "additionalProperties": { "type": "boolean" } },
    "advanced":  { "type": "object", "additionalProperties": { "type": "boolean" } },
    "quotas": {
      "type": "object",
      "properties": {
        "agent_count_limit":   { "type": "integer" },
        "skill_count_limit":   { "type": "integer" },
        "monthly_llm_rmb":     { "type": "number" },
        "monthly_tts_seconds": { "type": "number" },
        "tenants_max":         { "type": "integer" }
      }
    }
  }
}
